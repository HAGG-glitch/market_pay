# Copy this file to .env and fill in real values before running locally.
# Docker Compose reads these automatically.

# PostgreSQL
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=marketpay
DATABASE_USER=marketpay
DATABASE_PASSWORD=marketpay_secret
DATABASE_SSL_MODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Monime
MONIME_BASE_URL=https://api.monime.com/v1
MONIME_API_KEY=your-monime-api-key
MONIME_WEBHOOK_SECRET=your-webhook-secret

# Notifications
NOTIFICATIONS_SMS_API_KEY=your-africas-talking-key
NOTIFICATIONS_SMS_USERNAME=marketpay
NOTIFICATIONS_WHATSAPP_ACCOUNT_SID=your-twilio-sid
NOTIFICATIONS_WHATSAPP_AUTH_TOKEN=your-twilio-token

# App
APP_ENV=development
APP_PORT=8080
APP_GRPC_PORT=9090
