{
  "version": "1.0",
  "pages": [
    {
      "id": "mp_access_gate_exchange",
      "component": {
        "type": "side_effect"
      },
      "on_done": {
        "action": "exchange",
        "url": "https://market-pay-fpsi.onrender.com/api/v1/monime/exchange",
        "dataExport": {}
      }
    },
    {
      "id": "mp_select_service",
      "component": {
        "type": "menu",
        "label": "Welcome to MarketPay\nSelect service",
        "items": [
          { "label": "Register vendor", "value": "register_vendor" },
          { "label": "Pay vendor", "value": "pay_vendor" },
          { "label": "Transaction history", "value": "transaction_history" },
          { "label": "Check balance", "value": "balance_check" },
          { "label": "Loan eligibility", "value": "loan_eligibility" },
          { "label": "Loan application", "value": "loan_application" },
          { "label": "Exit", "value": "exit" }
        ]
      },
      "on_done": {
        "action": "next",
        "session_context": {
          "mutations": {
            "selected_service": "$(page.mp_select_service.value)"
          }
        }
      }
    },
    {
      "id": "mp_collect_vendor_name",
      "component": {
        "type": "prompt",
        "data_type": "text",
        "label": "Enter vendor full name",
        "min_length": 2,
        "max_length": 50
      },
      "options": { "skip": "$(sc.selected_service != \"register_vendor\")" },
      "on_done": {
        "action": "next",
        "session_context": { "mutations": { "registration_vendor_name": "$(page.mp_collect_vendor_name.value)" } }
      }
    },
    {
      "id": "mp_collect_market_name",
      "component": {
        "type": "prompt",
        "data_type": "text",
        "label": "Enter market name",
        "min_length": 2,
        "max_length": 50
      },
      "options": { "skip": "$(sc.selected_service != \"register_vendor\")" },
      "on_done": {
        "action": "exchange",
        "url": "https://market-pay-fpsi.onrender.com/api/v1/monime/exchange",
        "dataExport": {
          "selected_service": "$(sc.selected_service)",
          "registration_vendor_name": "$(sc.registration_vendor_name)",
          "registration_market_name": "$(page.mp_collect_market_name.value)"
        },
        "session_context": { "mutations": { "registration_market_name": "$(page.mp_collect_market_name.value)" } }
      }
    },
    {
      "id": "mp_show_vendor_registration_result",
      "component": {
        "type": "display",
        "label": "$(data.message)"
      },
      "options": { "skip": "$(sc.selected_service != \"register_vendor\")" }
    },
    {
      "id": "mp_collect_payment_vendor_code",
      "component": {
        "type": "prompt",
        "data_type": "text",
        "label": "Enter vendor code (e.g. MP12345)",
        "min_length": 7,
        "max_length": 12,
        "pattern": "^MP[0-9]{5,10}$"
      },
      "options": { "skip": "$(sc.selected_service != \"pay_vendor\")" },
      "on_done": {
        "action": "next",
        "session_context": { "mutations": { "payment_vendor_code": "$(page.mp_collect_payment_vendor_code.value)" } }
      }
    },
    {
      "id": "mp_collect_payment_amount",
      "component": {
        "type": "prompt",
        "data_type": "integer",
        "label": "Enter amount in SLE",
        "min_value": 1,
        "max_value": 10000000
      },
      "options": { "skip": "$(sc.selected_service != \"pay_vendor\")" },
      "on_done": {
        "action": "next",
        "session_context": { "mutations": { "payment_amount": "$(page.mp_collect_payment_amount.value)" } }
      }
    },
    {
      "id": "mp_confirm_payment_receipt",
      "component": {
        "type": "menu",
        "label": "Confirm payment?",
        "items": [
          { "label": "Confirm & pay", "value": "confirm" },
          { "label": "Cancel", "value": "cancel" }
        ]
      },
      "options": { "skip": "$(sc.selected_service != \"pay_vendor\")" },
      "on_done": {
        "action": "exchange",
        "url": "https://market-pay-fpsi.onrender.com/api/v1/monime/exchange",
        "dataExport": {
          "selected_service": "$(sc.selected_service)",
          "payment_vendor_code": "$(sc.payment_vendor_code)",
          "payment_amount": "$(sc.payment_amount)",
          "payment_confirmed": "$(page.mp_confirm_payment_receipt.value != \"cancel\")",
          "payment_send_sms_receipt": "$(page.mp_confirm_payment_receipt.value == \"send_sms\")"
        },
        "session_context": {
          "mutations": {
            "payment_confirmed": "$(page.mp_confirm_payment_receipt.value != \"cancel\")",
            "payment_send_sms_receipt": "$(page.mp_confirm_payment_receipt.value == \"send_sms\")"
          }
        }
      }
    },
    {
      "id": "mp_collect_payment_pin",
      "component": {
        "type": "collect_payment"
      },
      "options": { "skip": "$(sc.selected_service != \"pay_vendor\" || sc.payment_confirmed != true)" },
      "on_done": {
        "action": "exchange",
        "url": "https://market-pay-fpsi.onrender.com/api/v1/monime/exchange",
        "dataExport": {
          "selected_service": "$(sc.selected_service)",
          "payment_vendor_code": "$(sc.payment_vendor_code)",
          "payment_amount": "$(sc.payment_amount)",
          "payment_send_sms_receipt": "$(sc.payment_send_sms_receipt)"
        },
        "recurring_context": {
          "mutations": {
            "last_txn_1": "$(page.mp_collect_payment_vendor_code.value + \" - SLE \" + page.mp_collect_payment_amount.value)",
            "last_txn_2": "$(rc.last_txn_1)",
            "last_txn_3": "$(rc.last_txn_2)"
          }
        }
      }
    },
    {
      "id": "mp_show_payment_result_sms",
      "component": { "type": "display", "label": "Payment of SLE $(data.amount) sent to vendor $(data.vendor_code).\nRef: $(data.reference)\nTransaction history updated.\nSMS receipt will be sent." },
      "options": { "skip": "$(sc.selected_service != \"pay_vendor\")" }
    },
    {
      "id": "mp_show_payment_result_no_sms",
      "component": { "type": "display", "label": "Payment of SLE $(data.amount) sent to vendor $(data.vendor_code).\nRef: $(data.reference)\nTransaction history updated." },
      "options": { "skip": "$(sc.selected_service != \"pay_vendor\")" }
    },
    {
      "id": "mp_show_payment_cancelled",
      "component": { "type": "display", "label": "Payment cancelled" },
      "options": { "skip": "$(sc.selected_service != \"pay_vendor\")" }
    },
    {
      "id": "mp_balance_exchange",
      "component": { "type": "side_effect" },
      "options": { "skip": "$(sc.selected_service != \"balance_check\")" },
      "on_done": {
        "action": "exchange",
        "url": "https://market-pay-fpsi.onrender.com/api/v1/monime/exchange",
        "dataExport": {
          "selected_service": "$(sc.selected_service)"
        }
      }
    },
    {
      "id": "mp_show_balance_result",
      "component": { "type": "display", "label": "$(data.message)" },
      "options": { "skip": "$(sc.selected_service != \"balance_check\")" }
    },
    {
      "id": "mp_loan_eligibility_exchange",
      "component": { "type": "side_effect" },
      "options": { "skip": "$(sc.selected_service != \"loan_eligibility\")" },
      "on_done": {
        "action": "exchange",
        "url": "https://market-pay-fpsi.onrender.com/api/v1/monime/exchange",
        "dataExport": {
          "selected_service": "$(sc.selected_service)"
        }
      }
    },
    {
      "id": "mp_show_loan_eligibility_result",
      "component": { "type": "display", "label": "$(data.message)" },
      "options": { "skip": "$(sc.selected_service != \"loan_eligibility\")" }
    },
    {
      "id": "mp_collect_loan_amount",
      "component": {
        "type": "prompt",
        "data_type": "integer",
        "label": "Enter loan amount in SLE",
        "min_value": 50,
        "max_value": 5000000
      },
      "options": { "skip": "$(sc.selected_service != \"loan_application\")" },
      "on_done": {
        "action": "next",
        "session_context": { "mutations": { "loan_amount": "$(page.mp_collect_loan_amount.value)" } }
      }
    },
    {
      "id": "mp_confirm_loan_application",
      "component": {
        "type": "menu",
        "label": "Submit loan application?",
        "items": [
          { "label": "Submit", "value": "submit" },
          { "label": "Cancel", "value": "cancel" }
        ]
      },
      "options": { "skip": "$(sc.selected_service != \"loan_application\")" },
      "on_done": {
        "action": "exchange",
        "url": "https://market-pay-fpsi.onrender.com/api/v1/monime/exchange",
        "dataExport": {
          "selected_service": "$(sc.selected_service)",
          "loan_amount": "$(sc.loan_amount)",
          "loan_confirmed": "$(page.mp_confirm_loan_application.value == \"submit\")"
        },
        "session_context": {
          "mutations": {
            "loan_confirmed": "$(page.mp_confirm_loan_application.value == \"submit\")"
          }
        }
      }
    },
    {
      "id": "mp_show_loan_application_result",
      "component": { "type": "display", "label": "$(data.message)" },
      "options": { "skip": "$(sc.selected_service != \"loan_application\")" }
    },
    {
      "id": "mp_show_loan_application_cancelled",
      "component": { "type": "display", "label": "Loan application cancelled" },
      "options": { "skip": "$(sc.selected_service != \"loan_application\" || sc.loan_confirmed == true)" }
    },
    {
      "id": "mp_exit_service",
      "component": { "type": "display", "label": "Thanks for using MarketPay." },
      "options": { "skip": "$(sc.selected_service != \"exit\")" }
    }
  ]
}
